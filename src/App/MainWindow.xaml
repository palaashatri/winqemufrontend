<Window
    x:Class="WinQemu.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinQemu.App.ViewModels"
    Title="WinQEMU — Virtual Machine Manager">

    <Grid x:Name="MainRootGrid" SizeChanged="OnMainRootSizeChanged" AllowDrop="True" DragOver="OnMainRootDragOver" Drop="OnMainRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Row 0: Native Integrated Windows 11 Title Bar Region (§4, §85) -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Background="Transparent" Padding="14,0,148,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image x:Name="TitleBarBrandIcon" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="WinQEMU" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleBarSubtitle"
                               Text="Virtual Machine Manager for Windows 11"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status Pills in Title Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="WhpxStatusPill"
                            Background="#238636"
                            BorderBrush="#2EA043"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="WhpxStatusPillIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="11" Foreground="White" />
                            <TextBlock x:Name="WhpxStatusPillText" Text="Probing Acceleration..." FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="QemuVersionPillBorder"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="QemuVersionPillText" Text="QEMU Runtime" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Fluent Left Navigation Sidebar + Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail / Sidebar (§63) -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0"
                    Padding="10,12">
                <Grid AutomationProperties.AutomationId="PrimaryNavigationBar">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SidebarTopStack" Spacing="4">
                            <!-- Primary New VM CTA -->
                            <Grid Margin="0,0,0,8">
                                <Button x:Name="NavWizardBtn"
                                        Click="OnNavWizardClick"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,10"
                                        CornerRadius="4"
                                        AutomationProperties.AutomationId="NavWizardBtn"
                                        AutomationProperties.Name="Create New Virtual Machine"
                                        ToolTipService.ToolTip="Create a new virtual machine from ISO or preset (Ctrl+N)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="15" />
                                        <TextBlock x:Name="NavWizardLabel" Text="New VM" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavWizardIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="3,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>

                            <!-- Home Library -->
                            <Grid>
                                <Border x:Name="NavHomeHighlight"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Visible" />
                                <Button x:Name="NavHomeBtn"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        Click="OnNavHomeClick"
                                        AutomationProperties.AutomationId="NavHomeBtn"
                                        AutomationProperties.Name="Home Virtual Machine Library"
                                        ToolTipService.ToolTip="View all virtual machines (Alt+1)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Menu" Key="Number1" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="16" />
                                        <TextBlock x:Name="NavHomeLabel" Text="Home Library" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavHomeIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Visible" />
                            </Grid>

                            <!-- Guest Display -->
                            <Grid>
                                <Border x:Name="NavConsoleHighlight"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                <Button x:Name="NavConsoleBtn"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        Click="OnNavConsoleClick"
                                        AutomationProperties.AutomationId="NavConsoleBtn"
                                        AutomationProperties.Name="Embedded Guest Display Console"
                                        ToolTipService.ToolTip="Open embedded guest framebuffer console (Alt+2)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Menu" Key="Number2" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="16" />
                                        <TextBlock x:Name="NavConsoleLabel" Text="Guest Display" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavConsoleIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>

                            <!-- Hardware Editor -->
                            <Grid>
                                <Border x:Name="NavHardwareHighlight"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                <Button x:Name="NavHardwareBtn"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        Click="OnNavHardwareClick"
                                        AutomationProperties.AutomationId="NavHardwareBtn"
                                        AutomationProperties.Name="Advanced Hardware Editor"
                                        ToolTipService.ToolTip="Configure CPU, RAM, disks, network, UEFI, TPM, and raw QEMU args">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="16" />
                                        <TextBlock x:Name="NavHardwareLabel" Text="Hardware Editor" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavHardwareIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>

                            <!-- Snapshots & Clone -->
                            <Grid>
                                <Border x:Name="NavSnapshotsHighlight"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                <Button x:Name="NavSnapshotsBtn"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        Click="OnNavSnapshotsClick"
                                        AutomationProperties.AutomationId="NavSnapshotsBtn"
                                        AutomationProperties.Name="Snapshots and Cloning"
                                        ToolTipService.ToolTip="Manage snapshots, full clones, and linked clones">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="16" />
                                        <TextBlock x:Name="NavSnapshotsLabel" Text="Snapshots &amp; Clone" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavSnapshotsIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>

                            <!-- Multi-Arch & Downloads -->
                            <Grid>
                                <Border x:Name="NavDownloadsHighlight"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                <Button x:Name="NavDownloadsBtn"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        Click="OnNavDownloadsClick"
                                        AutomationProperties.AutomationId="NavDownloadsBtn"
                                        AutomationProperties.Name="Multi-Architecture Lab and OS Downloads"
                                        ToolTipService.ToolTip="Download official distros or provision bootable multi-architecture VMs">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="16" />
                                        <TextBlock x:Name="NavDownloadsLabel" Text="Multi-Arch &amp; ISO" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="NavDownloadsIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer Utility & Settings -->
                    <StackPanel Grid.Row="1" Spacing="4" Padding="0,8,0,0">
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0,4,6" />

                        <Button x:Name="QuickShowcaseBtn"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="OnProvisionShowcaseClick"
                                AutomationProperties.AutomationId="ProvisionMultiArchBtn"
                                AutomationProperties.Name="Provision Bootable Linux, FreeBSD, Windows, and macOS VMs across all architectures"
                                ToolTipService.ToolTip="Populate bootable Linux, FreeBSD, Windows, and macOS VMs across x86_64, i386, ARM64, RISC-V 64, and PowerPC 64">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="16" />
                                <TextBlock x:Name="QuickShowcaseLabel" Text="Provision 9 VMs" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Grid>
                            <Border x:Name="NavSettingsHighlight"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                            <Button x:Name="NavSettingsBtn"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="OnNavSettingsClick"
                                    AutomationProperties.AutomationId="NavSettingsBtn"
                                    AutomationProperties.Name="Settings and Diagnostics"
                                    ToolTipService.ToolTip="Global preferences, WHPX status, QEMU runtime, and diagnostics">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" />
                                    <TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavSettingsIndicator"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Workspace -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="1" Padding="20,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">

                <!-- ==================== VIEW 1: HOME VM LIBRARY ==================== -->
                <Grid x:Name="LibraryViewPanel" Visibility="Visible">
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="10" />
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Responsive Library Header -->
                    <Border x:Name="HomeAccelBanner"
                            Grid.Row="0"
                            Margin="0,0,0,14"
                            Padding="16,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="14" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="BannerHeadlineText"
                                           Text="Virtual Machines"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="BannerDetailText"
                                           Text="Create, boot, snapshot, and clone virtual machines across x86_64, i386, ARM64, RISC-V 64, and PowerPC 64."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid x:Name="LibraryHeaderActions"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="SearchBoxHost" Grid.Row="0" Grid.Column="0">
                                    <TextBox x:Name="SearchBox"
                                             Width="220"
                                             CornerRadius="4"
                                             Padding="32,5,10,5"
                                             PlaceholderText="Search VMs, OS, arch..."
                                             TextChanged="OnSearchBoxTextChanged"
                                             AutomationProperties.AutomationId="VmSearchBox"
                                             AutomationProperties.Name="Search Virtual Machines" />
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE721;"
                                              FontSize="13"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              IsHitTestVisible="False" />
                                </Grid>

                                <StackPanel x:Name="LibraryHeaderButtons"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="EnableWhpxBannerBtn"
                                            CornerRadius="4"
                                            Click="OnEnableWhpxClick"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Enable Windows Hypervisor Platform"
                                            ToolTipService.ToolTip="Request elevation to enable Windows Hypervisor Platform via DISM">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock Text="Enable WHPX" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ImportQvmBtn"
                                            CornerRadius="4"
                                            Click="OnImportDiskOrPackageClick"
                                            AutomationProperties.Name="Import Portable VM or Disk Image"
                                            ToolTipService.ToolTip="Import a .qvm package or virtual disk image (.qcow2, .raw, .vhdx, .vmdk)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14" />
                                            <TextBlock Text="Import .qvm / Disk" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- VM Grid View -->
                    <GridView x:Name="VmGridView"
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnVmGridSelectionChanged"
                              AutomationProperties.AutomationId="VmLibraryGridView"
                              AutomationProperties.Name="Virtual Machines Library">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:VmCardItem">
                                <Border Width="340"
                                        Margin="6"
                                        Padding="16"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <!-- Card Header: Title + Accel Pill + Status Pill -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ArchitectureBadge, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                                                <!-- WHPX Acceleration Badge -->
                                                <Border Visibility="{x:Bind WhpxBadgeVisibility, Mode=OneWay}"
                                                        Background="#238636"
                                                        BorderBrush="#2EA043"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="Windows Hypervisor Platform hardware acceleration">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="10" Foreground="White" />
                                                        <TextBlock Text="{x:Bind AcceleratorBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- TCG Acceleration Badge -->
                                                <Border Visibility="{x:Bind TcgBadgeVisibility, Mode=OneWay}"
                                                        Background="#1F6FEB"
                                                        BorderBrush="#388BFD"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="QEMU Tiny Code Generator emulation">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="10" Foreground="White" />
                                                        <TextBlock Text="{x:Bind AcceleratorBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- Live State Badge -->
                                                <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="{x:Bind StatusDotColor, Mode=OneWay}" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Guest Screen Preview / Live Framebuffer Thumbnail (§39) -->
                                        <Border Height="144"
                                                CornerRadius="6"
                                                Background="#0A0E14"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <StackPanel Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Spacing="8"
                                                            Padding="12">
                                                    <Border Width="42"
                                                            Height="42"
                                                            CornerRadius="21"
                                                            Background="#1F58A6FF"
                                                            BorderBrush="#3D58A6FF"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                                  Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                                                  FontSize="18"
                                                                  Foreground="#79C0FF" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind OsDisplayName, Mode=OneWay}"
                                                               Foreground="#E6EDF3"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Image Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}"
                                                       Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Subtle Spec Footer Strip -->
                                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                          Glyph="&#xE964;"
                                                          FontSize="12"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ResourceSummary, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Card Actions Row (§40) -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Tag="{x:Bind}"
                                                    Click="OnCardPrimaryActionClick"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="4"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    AutomationProperties.Name="Start or Open Virtual Machine">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}" FontSize="13" />
                                                    <TextBlock Text="{x:Bind PrimaryActionText, Mode=OneWay}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    CornerRadius="4"
                                                    Padding="10,7"
                                                    Tag="{x:Bind}"
                                                    Click="OnCardHardwareClick"
                                                    ToolTipService.ToolTip="Edit VM Hardware"
                                                    AutomationProperties.Name="Edit VM Hardware">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    CornerRadius="4"
                                                    Padding="10,7"
                                                    Tag="{x:Bind}"
                                                    Click="OnCardSnapshotsClick"
                                                    ToolTipService.ToolTip="Snapshots and Clone"
                                                    AutomationProperties.Name="Snapshots and Clone">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    CornerRadius="4"
                                                    Padding="10,7"
                                                    Tag="{x:Bind}"
                                                    AutomationProperties.Name="More VM Actions"
                                                    ToolTipService.ToolTip="More VM Actions">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Open Embedded Display" Tag="{x:Bind}" Click="OnCardOpenDisplayClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Detach into Separate Window" Tag="{x:Bind}" Click="OnCardDetachWindowClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Pause / Resume" Tag="{x:Bind}" Click="OnCardPauseResumeClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Restart Guest" Tag="{x:Bind}" Click="OnCardRestartClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Shut Down Gracefully" Tag="{x:Bind}" Click="OnCardShutDownClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Force Stop (Power Off)" Tag="{x:Bind}" Click="OnCardForceStopClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Snapshots &amp; Restore..." Tag="{x:Bind}" Click="OnCardSnapshotsClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Clone Virtual Machine..." Tag="{x:Bind}" Click="OnCardSnapshotsClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Hardware Settings..." Tag="{x:Bind}" Click="OnCardHardwareClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Export Portable .qvm..." Tag="{x:Bind}" Click="OnCardExportClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE1;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete Virtual Machine" Tag="{x:Bind}" Click="OnCardDeleteClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- ==================== VIEW 2: EMBEDDED GUEST DISPLAY CONSOLE (§28–§35, §52–§53) ==================== -->
                <Grid x:Name="ConsoleViewPanel" Visibility="Collapsed" KeyDown="OnConsoleKeyDown" KeyUp="OnConsoleKeyUp" LostFocus="OnConsoleLostFocus" IsTabStop="True">
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="10" />
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Two-Part Fluent Console Toolbar -->
                    <Border Grid.Row="0"
                            Padding="12,10"
                            CornerRadius="8,8,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <!-- Row 0: VM Selector, Accel Badge, State + Primary Power & Drawer Toggle -->
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="ConsoleVmSelector"
                                              Width="210"
                                              CornerRadius="4"
                                              SelectionChanged="OnConsoleVmSelectorChanged"
                                              DisplayMemberPath="Name"
                                              AutomationProperties.AutomationId="ConsoleVmSelector"
                                              AutomationProperties.Name="Active Virtual Machine in Console" />
                                    <Border x:Name="ConsoleAccelBadgeBorder"
                                            Background="#238636"
                                            BorderBrush="#2EA043"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon x:Name="ConsoleAccelIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="11" Foreground="White" />
                                            <TextBlock x:Name="ConsoleAccelBadge" Text="WHPX ACCELERATED" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ConsoleStateText" Text="Stopped" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="ConsolePrimaryRightBar" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="ConsoleStartStopBtn"
                                            Click="OnConsoleStartStopClick"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="12,6"
                                            MinHeight="32"
                                            CornerRadius="4"
                                            AutomationProperties.AutomationId="ConsoleStartStopBtn"
                                            AutomationProperties.Name="Start or Shut Down VM">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="ConsoleStartStopIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="13" />
                                            <TextBlock x:Name="ConsoleStartStopText" Text="Start VM" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton x:Name="ToggleDevDrawerBtn"
                                                  Style="{StaticResource ToolbarCompactToggleStyle}"
                                                  Click="OnToggleDevDrawerClick"
                                                  IsChecked="False"
                                                  AutomationProperties.Name="Toggle Serial Console and QMP Inspector Drawer"
                                                  ToolTipService.ToolTip="Show or hide COM1 serial console and QMP inspector drawer">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="14" />
                                            <TextBlock Text="Serial &amp; QMP" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Guest Power, Media, Scaling & Window Controls -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="ConsolePauseBtn" Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsolePauseClick" AutomationProperties.Name="Pause or Resume VM">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="ConsolePauseIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" FontSize="13" />
                                            <TextBlock x:Name="ConsolePauseText" Text="Pause" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsoleResetClick" AutomationProperties.Name="Reset VM">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="Reset" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsoleForceOffClick" AutomationProperties.Name="Force Stop VM" ToolTipService.ToolTip="Immediately power off the virtual machine">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="13" />
                                            <TextBlock Text="Force Off" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="20" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />
                                    <Button Style="{StaticResource ToolbarCompactButtonStyle}" AutomationProperties.Name="Removable CD/DVD ISO Menu">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE958;" FontSize="13" />
                                            <TextBlock Text="CD/ISO" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Name="CurrentIsoMenuText" Text="ISO: Attached" IsEnabled="False" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Choose ISO Image..." Click="OnConsoleChangeIsoClick">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Eject CD/DVD Media" Click="OnConsoleEjectIsoClick">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF847;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <ComboBox x:Name="ScalingModeCombo"
                                              SelectedIndex="0"
                                              SelectionChanged="OnScalingModeChanged"
                                              Width="112"
                                              CornerRadius="4"
                                              AutomationProperties.Name="Display Scaling Mode">
                                        <ComboBoxItem Content="Fit Aspect" />
                                        <ComboBoxItem Content="Stretch" />
                                        <ComboBoxItem Content="1:1 Pixel" />
                                    </ComboBox>
                                    <Border Width="1" Height="20" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />
                                    <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsoleCaptureScreenshotClick" AutomationProperties.AutomationId="ConsoleCaptureBtn" AutomationProperties.Name="Capture Guest Screenshot" ToolTipService.ToolTip="Save guest framebuffer screenshot to PNG">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" FontSize="13" />
                                            <TextBlock Text="Capture" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsoleDetachWindowClick" AutomationProperties.Name="Detach VM into Separate Window" ToolTipService.ToolTip="Open this VM in a standalone window">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="13" />
                                            <TextBlock Text="Detach" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ConsoleFullscreenBtn" Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnConsoleFullscreenClick" AutomationProperties.Name="Toggle Fullscreen Display">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="ConsoleFullscreenIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="13" />
                                            <TextBlock x:Name="ConsoleFullscreenText" Text="Fullscreen" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Center Framebuffer + Optional 320px Serial/QMP Side Drawer -->
                    <Grid Grid.Row="1" Background="#05070A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="DevDrawerColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <!-- Framebuffer Viewport -->
                        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" Background="#05070A" Padding="8">
                            <Grid>
                                <Image x:Name="EmbeddedFramebufferImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       PointerPressed="OnEmbeddedViewportPointerPressed"
                                       PointerMoved="OnEmbeddedViewportPointerMoved"
                                       PointerReleased="OnEmbeddedViewportPointerReleased" />

                                <Border x:Name="EmbeddedDisplayOverlay"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="24,18"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmbeddedOverlayTitle" Text="Guest Display Ready" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmbeddedOverlaySubtitle" Text="Press 'Start VM' to boot the selected virtual machine inside this embedded framebuffer." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Developer Serial Console & QMP Inspector Drawer (§51–§53) -->
                        <Border x:Name="DevDrawerPanel"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Serial Console (§52) -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="SERIAL CONSOLE (COM1 / UART)" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0A0E14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <ScrollViewer>
                                            <TextBlock x:Name="SerialConsoleOutputText"
                                                       FontFamily="Consolas"
                                                       FontSize="11.5"
                                                       Foreground="#3FB950"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       Text="[Serial console connected on loopback socket]" />
                                        </ScrollViewer>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SerialInputBox" CornerRadius="4" PlaceholderText="Send serial input..." FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Serial Console Input" />
                                        <Button Grid.Column="1" CornerRadius="4" Content="Send" Click="OnSendSerialInputClick" AutomationProperties.Name="Send Serial Command" />
                                    </Grid>
                                </Grid>

                                <!-- QMP Inspector (§53) -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE943;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="QMP PROTOCOL INSPECTOR" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0A0E14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <ScrollViewer>
                                            <TextBlock x:Name="QmpInspectorOutputText"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#E6EDF3"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       Text="&gt; query-status" />
                                        </ScrollViewer>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QmpCommandInputBox" CornerRadius="4" Text="query-status" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="QMP Inspector Command Input" />
                                        <Button Grid.Column="1" CornerRadius="4" Content="Run QMP" Click="OnExecuteQmpInspectorClick" AutomationProperties.Name="Execute QMP Command" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Console Footer Metrics Bar (§55) -->
                    <Border Grid.Row="2"
                            Padding="14,7"
                            CornerRadius="0,0,8,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConsoleFooterLeftText"
                                       Text="Localhost VNC Transport (127.0.0.1) · Host Key: Ctrl+Alt"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ConsoleFooterMetricsText"
                                       Text="Configured RAM: 512 MiB · Host Working Set: 0 MiB · Host CPU: 0.0%"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== VIEW 3: EXPRESS NEW VM WIZARD (§13–§16, §37) ==================== -->
                <ScrollViewer x:Name="WizardViewPanel" Visibility="Collapsed">
                    <Border MaxWidth="900"
                            HorizontalAlignment="Stretch"
                            Padding="18"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="10" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Create a Virtual Machine" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Pick an installer ISO or choose an operating system preset across x86_64, i386, ARM64, RISC-V 64, or PowerPC 64. WinQEMU configures firmware, storage, networking, and acceleration automatically."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Step 1: ISO Selection & Auto-Recognition (§13, §14) -->
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE958;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="1. Installer Media (Optional — or boot from preset)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WizardIsoPathBox"
                                                 CornerRadius="4"
                                                 PlaceholderText="Path to .iso installer image (or drag &amp; drop an ISO onto the window)..."
                                                 TextChanged="OnWizardIsoPathChanged"
                                                 AutomationProperties.AutomationId="WizardIsoPathBox"
                                                 AutomationProperties.Name="Installer ISO Path" />
                                        <Button Grid.Column="1" CornerRadius="4" Click="OnWizardBrowseIsoClick" AutomationProperties.Name="Browse for Installer ISO">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14" />
                                                <TextBlock Text="Browse ISO" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="WizardIsoRecognitionText"
                                               Text="Select an ISO to automatically detect Windows, Linux, BSD, or macOS and its target architecture."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Step 2: Operating System & Architecture Preset (§15) -->
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="2. Operating System &amp; Architecture Preset" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid x:Name="WizardPresetNameGrid" ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="WizardPresetField" Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Guest Preset" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="WizardPresetCombo"
                                                      CornerRadius="4"
                                                      HorizontalAlignment="Stretch"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="OnWizardPresetSelectionChanged"
                                                      AutomationProperties.AutomationId="WizardPresetCombo"
                                                      AutomationProperties.Name="Operating System Preset" />
                                        </StackPanel>
                                        <StackPanel x:Name="WizardVmNameField" Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Virtual Machine Name" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox x:Name="WizardVmNameBox"
                                                     CornerRadius="4"
                                                     Text="Ubuntu Linux"
                                                     AutomationProperties.AutomationId="WizardVmNameBox"
                                                     AutomationProperties.Name="Virtual Machine Name" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="WizardPresetSummaryText"
                                               Text="Modern VirtIO storage, network &amp; GPU · UEFI"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Step 3: Recommended Resources (§16) -->
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="3. Hardware Resources (Memory, CPU, Disk Size)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid x:Name="WizardResourcesGrid" ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="WizardRamField" Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="WizardRamLabel" Text="Memory (MiB) — Recommended: 4096 MiB" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Slider x:Name="WizardRamSlider" Minimum="256" Maximum="16384" StepFrequency="256" Value="4096" ValueChanged="OnWizardResourceSliderChanged" AutomationProperties.AutomationId="WizardRamSlider" AutomationProperties.Name="Memory Allocation MiB" />
                                        </StackPanel>
                                        <StackPanel x:Name="WizardCpuField" Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="WizardCpuLabel" Text="Virtual CPUs — Recommended: 4" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Slider x:Name="WizardCpuSlider" Minimum="1" Maximum="16" StepFrequency="1" Value="4" ValueChanged="OnWizardResourceSliderChanged" AutomationProperties.AutomationId="WizardCpuSlider" AutomationProperties.Name="Virtual CPU Cores" />
                                        </StackPanel>
                                        <StackPanel x:Name="WizardDiskField" Grid.Row="0" Grid.Column="2" Spacing="2">
                                            <TextBlock x:Name="WizardDiskLabel" Text="Virtual Disk (GiB) — Recommended: 32 GiB" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Slider x:Name="WizardDiskSlider" Minimum="4" Maximum="256" StepFrequency="4" Value="32" ValueChanged="OnWizardResourceSliderChanged" AutomationProperties.AutomationId="WizardDiskSlider" AutomationProperties.Name="Disk Size GiB" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="WizardResourceWarningText" Text="" Foreground="#F0883E" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Step 4: Express Unattended Installation (§37) -->
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <CheckBox x:Name="WizardExpressInstallCheck"
                                              Content="Enable Express Unattended Installation (Cloud-Init / Windows Autounattend seed ISO)"
                                              AutomationProperties.AutomationId="WizardExpressInstallCheck" />
                                    <Grid x:Name="WizardExpressFieldsGrid" ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="WizardUsernameBox" Grid.Row="0" Grid.Column="0" CornerRadius="4" Header="Guest Username" Text="user" />
                                        <TextBox x:Name="WizardHostnameBox" Grid.Row="0" Grid.Column="1" CornerRadius="4" Header="Guest Hostname" Text="winqemu-vm" />
                                        <PasswordBox x:Name="WizardPasswordBox" Grid.Row="0" Grid.Column="2" CornerRadius="4" Header="Optional Password (never logged)" />
                                    </Grid>
                                    <CheckBox x:Name="WizardWin11BypassCheck"
                                              Content="Include setup-time Windows 11 LabConfig requirement bypass (when software TPM emulator is not installed)"
                                              IsChecked="True" />
                                </StackPanel>
                            </Border>

                            <!-- Create Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button CornerRadius="4" Content="Cancel" Click="OnNavHomeClick" />
                                <Button x:Name="WizardCreateOnlyBtn" CornerRadius="4" Content="Create VM" Click="OnWizardCreateClick" AutomationProperties.AutomationId="WizardCreateOnlyBtn" />
                                <Button x:Name="WizardCreateAndStartBtn" CornerRadius="4" Click="OnWizardCreateAndStartClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="WizardCreateAndStartBtn">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="Create &amp; Start VM" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ==================== VIEW 4: ADVANCED HARDWARE EDITOR (§17, §18, §27) ==================== -->
                <ScrollViewer x:Name="HardwareViewPanel" Visibility="Collapsed">
                    <Border MaxWidth="960"
                            HorizontalAlignment="Stretch"
                            Padding="24"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="10" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <Grid x:Name="HwHeaderGrid" ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                    <TextBlock x:Name="HwEditorHeaderText"
                                               Text="Advanced Hardware Editor"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock x:Name="HwEditorSubtitleText"
                                               Text="Inspect and customize machine chipset, CPU topology, UEFI/Secure Boot, TPM 2.0, storage buses, port forwarding, and raw QEMU flags."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button x:Name="HwSaveChangesBtn"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Click="OnSaveHardwareEditorClick"
                                        Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="SaveHardwareBtn">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Save Hardware Changes" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- System, CPU, Memory, Firmware Row -->
                            <Grid x:Name="HwCoreFieldsGrid" ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="HwCol0Stack" Grid.Row="0" Grid.Column="0" Spacing="8">
                                    <TextBox x:Name="HwNameBox" CornerRadius="4" Header="VM Name" />
                                    <TextBox x:Name="HwMachineTypeBox" CornerRadius="4" Header="Machine Type (q35, pc, virt, mac99)" />
                                    <TextBox x:Name="HwCpuModelBox" CornerRadius="4" Header="CPU Model (max, qemu64, cortex-a72, rv64)" />
                                </StackPanel>
                                <StackPanel x:Name="HwCol1Stack" Grid.Row="0" Grid.Column="1" Spacing="8">
                                    <TextBox x:Name="HwVcpuCountBox" CornerRadius="4" Header="vCPU Cores" />
                                    <TextBox x:Name="HwMemoryMiBBox" CornerRadius="4" Header="Memory (MiB)" />
                                    <ComboBox x:Name="HwAcceleratorCombo" CornerRadius="4" Header="Accelerator Mode" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Auto (Prefer WHPX, fallback TCG)" />
                                        <ComboBoxItem Content="WHPX (Hardware Accelerated)" />
                                        <ComboBoxItem Content="TCG (Software Emulation)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="HwCol2Stack" Grid.Row="0" Grid.Column="2" Spacing="8">
                                    <ComboBox x:Name="HwFirmwareCombo" CornerRadius="4" Header="Firmware Type" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="UEFI (OVMF / EDK2)" />
                                        <ComboBoxItem Content="Legacy BIOS (SeaBIOS)" />
                                        <ComboBoxItem Content="OpenBIOS (PowerPC / SPARC)" />
                                        <ComboBoxItem Content="OpenSBI (RISC-V)" />
                                    </ComboBox>
                                    <TextBox x:Name="HwGpuModelBox" CornerRadius="4" Header="Virtual GPU (virtio-vga, VGA, virtio-gpu-pci)" />
                                    <TextBox x:Name="HwStorageBusBox" CornerRadius="4" Header="Primary Storage Bus (virtio-blk, sata, nvme, ide)" />
                                </StackPanel>
                            </Grid>

                            <!-- Security, Firmware Isolation & Developer Mode (2 columns × 3 rows) -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA18;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Security, Firmware Isolation &amp; Developer Mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid x:Name="HwFlagsGrid" ColumnSpacing="20" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="HwSecureBootCheck" Grid.Row="0" Grid.Column="0" Content="UEFI Secure Boot" />
                                        <CheckBox x:Name="HwTpm2Check" Grid.Row="0" Grid.Column="1" Content="TPM 2.0 Device (tpm-crb / tpm-tis)" />
                                        <CheckBox x:Name="HwGuestAgentCheck" Grid.Row="1" Grid.Column="0" Content="QEMU Guest Agent Channel" />
                                        <CheckBox x:Name="HwSerialConsoleCheck" Grid.Row="1" Grid.Column="1" Content="Serial Console Socket" />
                                        <CheckBox x:Name="HwGdbStubCheck" Grid.Row="2" Grid.Column="0" Content="GDB Debug Server (127.0.0.1:1234)" />
                                        <CheckBox x:Name="HwPauseAtStartCheck" Grid.Row="2" Grid.Column="1" Content="Pause CPU at Startup (-S)" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Port Forwarding UI (§27) -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE968;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="User-Mode NAT Port Forwarding (Localhost 127.0.0.1 → Guest)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>

                                    <Grid x:Name="PfAddGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="PfRuleNameBox" Grid.Row="0" Grid.Column="0" CornerRadius="4" PlaceholderText="Rule Name (e.g. SSH)" />
                                        <ComboBox x:Name="PfProtocolCombo" Grid.Row="0" Grid.Column="1" Width="92" CornerRadius="4" SelectedIndex="0">
                                            <ComboBoxItem Content="TCP" />
                                            <ComboBoxItem Content="UDP" />
                                        </ComboBox>
                                        <TextBox x:Name="PfHostPortBox" Grid.Row="0" Grid.Column="2" Width="105" CornerRadius="4" PlaceholderText="Host (2222)" Text="2222" />
                                        <TextBox x:Name="PfGuestPortBox" Grid.Row="0" Grid.Column="3" Width="105" CornerRadius="4" PlaceholderText="Guest (22)" Text="22" />
                                        <Button x:Name="PfAddBtn" Grid.Row="0" Grid.Column="4" CornerRadius="4" Click="OnAddPortForwardClick" AutomationProperties.Name="Add Port Forward Rule">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                                                <TextBlock Text="Add Rule" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="PortForwardRulesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PortForwardRuleItem">
                                                <Border Margin="0,0,0,6"
                                                        Padding="10,7"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#1F6FEB" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ProtocolBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind MappingSummary}" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                CornerRadius="4"
                                                                Padding="8,5"
                                                                Tag="{x:Bind}"
                                                                Click="OnRemovePortForwardClick"
                                                                AutomationProperties.Name="Remove Port Forward Rule"
                                                                ToolTipService.ToolTip="Remove port forward rule">
                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="13" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="PortForwardSummaryText"
                                               FontFamily="Consolas"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="No port forwarding rules configured." />
                                </StackPanel>
                            </Border>

                            <!-- Raw QEMU Escape Hatch & Generated Command Preview (§18) -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Additional Raw QEMU Arguments (Advanced Escape Hatch — §18)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox x:Name="HwRawArgsBox" CornerRadius="4" PlaceholderText="Optional extra flags separated by spaces, e.g. -no-hpet" FontFamily="Consolas" />
                                    <Grid Margin="0,4,0,0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Diagnostics → Generated QEMU Command Line" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" CornerRadius="4" Click="OnCopyGeneratedCommandClick" AutomationProperties.Name="Copy Generated QEMU Command">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock Text="Copy Command" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Background="#0A0E14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <TextBlock x:Name="GeneratedCommandPreviewText"
                                                   FontFamily="Consolas"
                                                   FontSize="11.5"
                                                   Foreground="#79C0FF"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ==================== VIEW 5: SNAPSHOTS & CLONING (§44, §45) ==================== -->
                <ScrollViewer x:Name="SnapshotsViewPanel" Visibility="Collapsed">
                    <Border MaxWidth="920"
                            HorizontalAlignment="Stretch"
                            Padding="24"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="10" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <TextBlock x:Name="SnapshotsHeaderText" Text="Snapshots &amp; Virtual Machine Cloning" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />

                            <!-- Create Snapshot Box -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Create New Snapshot (QCOW2 Offline or Live QMP savevm)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid x:Name="SnapshotCreateGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="NewSnapshotNameBox" Grid.Row="0" Grid.Column="0" CornerRadius="4" PlaceholderText="Snapshot name (e.g. Clean Install)" Text="Clean Install" AutomationProperties.AutomationId="NewSnapshotNameBox" />
                                        <TextBox x:Name="NewSnapshotDescBox" Grid.Row="0" Grid.Column="1" CornerRadius="4" PlaceholderText="Optional description (e.g. Before system updates)" />
                                        <Button x:Name="TakeSnapshotBtn" Grid.Row="0" Grid.Column="2" CornerRadius="4" Click="OnTakeSnapshotClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="TakeSnapshotBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                                                <TextBlock Text="Take Snapshot" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Background="#0A0E14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                        <TextBlock x:Name="SnapshotTreeText"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="#79C0FF"
                                                   TextWrapping="Wrap"
                                                   Text="Current State" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button CornerRadius="4" Click="OnRestoreLatestSnapshotClick" AutomationProperties.AutomationId="RestoreLatestSnapshotBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="13" />
                                                <TextBlock Text="Restore Latest" />
                                            </StackPanel>
                                        </Button>
                                        <Button CornerRadius="4" Click="OnDeleteLatestSnapshotClick" AutomationProperties.AutomationId="DeleteLatestSnapshotBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="13" />
                                                <TextBlock Text="Delete Latest" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Clone VM Box (§45) -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Clone Virtual Machine (Full Independent Clone or Linked Overlay Clone)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid x:Name="CloneCreateGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="CloneVmNameBox" Grid.Row="0" Grid.Column="0" CornerRadius="4" PlaceholderText="New clone VM name..." Text="Cloned VM" AutomationProperties.AutomationId="CloneVmNameBox" />
                                        <ComboBox x:Name="CloneTypeCombo" Grid.Row="0" Grid.Column="1" CornerRadius="4" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Full Clone (Independent)" />
                                            <ComboBoxItem Content="Linked Clone (Overlay)" />
                                        </ComboBox>
                                        <Button x:Name="ExecuteCloneBtn" Grid.Row="0" Grid.Column="2" CornerRadius="4" Click="OnExecuteCloneVmClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ExecuteCloneVmBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock Text="Clone VM" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="CloneDependencyGraphText"
                                               FontFamily="Consolas"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="Disk Dependency Graph: No active linked-clone dependencies." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ==================== VIEW 6: MULTI-ARCH LAB & OS DOWNLOADS (§38) ==================== -->
                <ScrollViewer x:Name="DownloadsViewPanel" Visibility="Collapsed">
                    <Border MaxWidth="960"
                            HorizontalAlignment="Stretch"
                            Padding="24"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="10" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Multi-Architecture Virtualization Lab &amp; Official OS Downloads" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Provision ready-to-boot virtual machines across Linux, FreeBSD, Windows, and macOS spanning x86_64, i386, ARM64 (aarch64), RISC-V 64 (riscv64), and PowerPC 64 (ppc64), or copy official open-source distribution ISO links."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="1-Click Multi-Architecture Bootable VM Suite" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Creates and configures 9 self-contained bootable VMs (Ubuntu x86_64, Alpine ARM64, Debian RISC-V 64, Linux i386, FreeBSD x86_64, FreeBSD ARM64, Windows 11 x86_64, macOS Darwin x86_64, and Mac OS PowerPC64 mac99)."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid x:Name="DownloadsLabButtonsGrid" ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="DownloadsProvisionBtn" Grid.Row="0" Grid.Column="0" CornerRadius="4" Click="OnProvisionShowcaseClick" Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="14" />
                                                <TextBlock Text="Provision All 9 Multi-Arch VMs" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DownloadsBootAllBtn" Grid.Row="0" Grid.Column="1" CornerRadius="4" Click="OnBootAndScreenshotAllShowcaseVmsClick" AutomationProperties.AutomationId="BootAllShowcaseBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="14" />
                                                <TextBlock Text="Boot &amp; Screenshot All VMs" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ShowcaseProgressText" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Structured Official OS Download Cards (§38) -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Official Operating System ISO Catalog (§38)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>

                                <ItemsControl x:Name="OsDownloadCardsList" AutomationProperties.AutomationId="OsDownloadCardsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OsDownloadCardItem">
                                            <Border Margin="0,0,0,8"
                                                    Padding="14,12"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnSpacing="14" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Version}" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ArchitectureText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind KindBadgeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind PublisherAndSize}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind OfficialSourceUrl}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   ToolTipService.ToolTip="{x:Bind OfficialSourceUrl}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button CornerRadius="4"
                                                                Padding="10,6"
                                                                Tag="{x:Bind OfficialSourceUrl}"
                                                                Click="OnCopyDownloadUrlClick"
                                                                AutomationProperties.Name="Copy Download URL"
                                                                ToolTipService.ToolTip="Copy official download URL to clipboard">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13" />
                                                                <TextBlock Text="Copy URL" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button CornerRadius="4"
                                                                Padding="10,6"
                                                                Tag="{x:Bind OfficialSourceUrl}"
                                                                Click="OnOpenDownloadUrlClick"
                                                                AutomationProperties.Name="Open Official Download Page"
                                                                ToolTipService.ToolTip="Open official distribution URL in browser">
                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Plain-Text Catalog Summary" HorizontalAlignment="Stretch" IsExpanded="False">
                                    <TextBlock x:Name="OsDownloadCatalogText"
                                               FontFamily="Consolas"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ==================== VIEW 7: SETTINGS & DIAGNOSTICS (§48, §49, §50, §93) ==================== -->
                <ScrollViewer x:Name="SettingsViewPanel" Visibility="Collapsed">
                    <Border MaxWidth="960"
                            HorizontalAlignment="Stretch"
                            Padding="24"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="10" />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <TextBlock Text="Settings, Runtime Management &amp; Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                            <Grid x:Name="SettingsCardsGrid" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Appearance & Storage -->
                                <Border x:Name="SettingsAppearanceCard"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="16"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE771;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Appearance &amp; VM Storage (§48)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeSelectorCombo" CornerRadius="4" Header="Application Theme" SelectedIndex="0" SelectionChanged="OnThemeSelectorChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ThemeSelectorCombo">
                                            <ComboBoxItem Content="System Default" />
                                            <ComboBoxItem Content="Light Mode" />
                                            <ComboBoxItem Content="Dark Mode" />
                                        </ComboBox>
                                        <TextBox x:Name="SettingsStorageDirBox" CornerRadius="4" Header="Default VM Storage Location" />
                                        <ComboBox x:Name="ClosePolicyCombo" CornerRadius="4" Header="When Closing App While VMs Are Running (§42)" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Ask every time" />
                                            <ComboBoxItem Content="Keep VMs running in background" />
                                            <ComboBoxItem Content="Shut VMs down gracefully" />
                                            <ComboBoxItem Content="Force stop all VMs" />
                                        </ComboBox>
                                        <Button CornerRadius="4" Click="OnSaveSettingsClick" Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14" />
                                                <TextBlock Text="Save Preferences" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- QEMU Runtime & WHPX Status -->
                                <Border x:Name="SettingsRuntimeCard"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="16"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Virtualization Engine &amp; WHPX (§6–§8)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>

                                        <InfoBar x:Name="SettingsWhpxInfoBar"
                                                 IsOpen="True"
                                                 IsClosable="False"
                                                 Severity="Informational"
                                                 Title="Probing WHPX status..."
                                                 Message="Checking Windows Hypervisor Platform availability and QEMU runtime." />

                                        <TextBlock x:Name="SettingsRuntimeSummaryText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <!-- Responsive wrapping action grid so buttons never clip -->
                                        <Grid x:Name="SettingsRuntimeActionsGrid" ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button x:Name="SettingsReprobeBtn" Grid.Row="0" Grid.Column="0" CornerRadius="4" Click="OnReprobeRuntimeClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="13" />
                                                    <TextBlock Text="Re-Probe Runtime" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="InstallManagedQemuBtn" Grid.Row="0" Grid.Column="1" CornerRadius="4" Click="OnInstallManagedQemuClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="13" />
                                                    <TextBlock Text="Install QEMU" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="SettingsEnableWhpxBtn" Grid.Row="1" Grid.Column="0" CornerRadius="4" Click="OnEnableWhpxClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA18;" FontSize="13" />
                                                    <TextBlock Text="Enable WHPX" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Diagnostics & Readiness Score (§49, §93) -->
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Diagnostics &amp; Readiness Audit (Sanitized)" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" CornerRadius="4" Click="OnCopyDiagnosticsClick" AutomationProperties.AutomationId="CopyDiagnosticsBtn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock Text="Copy Sanitized Diagnostics" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Background="#0A0E14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <TextBlock x:Name="DiagnosticsReportText"
                                                   FontFamily="Consolas"
                                                   FontSize="11.5"
                                                   Foreground="#E6EDF3"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Row 2: Global Status Bar -->
        <Border Grid.Row="2"
                Padding="16,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GlobalStatusText"
                           Text="Ready."
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           x:Name="GlobalCountText"
                           Text="0 Virtual Machines"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
