<Window
    x:Class="WinQemu.App.VmDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Virtual Machine Display">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid x:Name="DisplayHeaderGrid" RowSpacing="8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16" />
                    <TextBlock x:Name="TitleText"
                               Text="Virtual Machine"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border x:Name="AccelBadgeBorder"
                            Background="#238636"
                            BorderBrush="#2EA043"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="AccelBadgeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="11" Foreground="White" />
                            <TextBlock x:Name="AccelBadgeText" Text="WHPX ACCELERATED" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="DisplayActionsScroller"
                              Grid.Row="0"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="PauseResumeBtn" Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnPauseResumeClick" AutomationProperties.Name="Pause or Resume Guest" ToolTipService.ToolTip="Pause or resume virtual machine">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PauseResumeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" FontSize="14" />
                                <TextBlock x:Name="PauseResumeText" Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnRestartClick" AutomationProperties.Name="Restart Guest" ToolTipService.ToolTip="Send warm reset signal">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Restart" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarCompactButtonStyle}" Content="Ctrl+Alt+Del" Click="OnCtrlAltDelClick" AutomationProperties.Name="Send Ctrl+Alt+Del" ToolTipService.ToolTip="Send Ctrl+Alt+Del key sequence to guest" />
                        <Button Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnScreenshotClick" AutomationProperties.Name="Capture Guest Screenshot" ToolTipService.ToolTip="Capture guest framebuffer screenshot">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" FontSize="14" />
                                <TextBlock Text="Capture" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullscreenBtn" Style="{StaticResource ToolbarCompactButtonStyle}" Click="OnFullscreenClick" AutomationProperties.Name="Toggle Fullscreen" ToolTipService.ToolTip="Toggle fullscreen display">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="FullscreenIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="14" />
                                <TextBlock x:Name="FullscreenText" Text="Fullscreen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Padding="10,6" MinHeight="32" CornerRadius="4" Click="OnShutDownClick" AutomationProperties.Name="Graceful Shut Down" ToolTipService.ToolTip="Request graceful guest shutdown">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="14" />
                                <TextBlock Text="Shut Down" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Guest Framebuffer Viewport -->
        <Border x:Name="ViewportBorder" Grid.Row="1" Background="#05070A" Margin="10" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ContentControl x:Name="ViewportFocusSink"
                            IsTabStop="True"
                            UseSystemFocusVisuals="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            PreviewKeyDown="OnViewportPreviewKeyDown"
                            PreviewKeyUp="OnViewportPreviewKeyUp"
                            GotFocus="OnViewportGotFocus"
                            LostFocus="OnViewportLostFocus">
                <Grid x:Name="ViewportGrid"
                      Background="Transparent"
                      PointerPressed="OnViewportPointerPressed"
                      PointerMoved="OnViewportPointerMoved"
                      PointerReleased="OnViewportPointerReleased">
                    <Image x:Name="FramebufferImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="OverlayStatusText"
                               Text="Connecting to guest display..."
                               Foreground="#C9D1D9"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </ContentControl>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusFooterText"
                           Text="Display active · Host key: Ctrl+Alt"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           x:Name="MetricsFooterText"
                           Text="Connecting..."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
